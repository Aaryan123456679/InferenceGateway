ENV=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:5433/gateway
REDIS_URL=redis://localhost:6380/0

ADMIN_KEY=change-me
OLLAMA_HOST=http://localhost:11435
HOSTED_API_BASE=
HOSTED_API_KEY=

CACHE_SIMILARITY_THRESHOLD=0.97
CACHE_TTL_SECONDS=3600
BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_SECONDS=30
REQUEST_TIMEOUT_SECONDS=30
PER_BACKEND_CONCURRENCY=16
DEFAULT_POLICY=latency

# Used by docker/smoke.sh only (not a GatewaySettings field) - the model
# pulled into the Docker ollama container and registered as a backend.
DEFAULT_MODEL=qwen2.5:0.5b
